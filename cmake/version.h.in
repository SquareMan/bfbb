/* Generated by borealis_detect_version(): do not edit. */
#ifndef BOREALIS_VERSION_H
#define BOREALIS_VERSION_H

/* git describe without the hash. */
#define BOREALIS_APP_DESCRIBE "@BOREALIS_APP_DESCRIBE@"
/* Four-part numeric version. */
#define BOREALIS_APP_VERSION "@BOREALIS_APP_VERSION@"
#define BOREALIS_APP_SHORT_VERSION "@BOREALIS_APP_SHORT_VERSION@"
/* Android version code: major*1e7 + minor*1e5 + patch*1e3 + tweak. */
#define BOREALIS_APP_VERSION_CODE @BOREALIS_APP_VERSION_CODE@

#define BOREALIS_APP_BRANCH "@BOREALIS_APP_BRANCH@"
#define BOREALIS_APP_REVISION "@BOREALIS_APP_REVISION@"
#define BOREALIS_APP_DATE "@BOREALIS_APP_DATE@"

#define BOREALIS_PLATFORM_NAME "@BOREALIS_PLATFORM_NAME@"

/* Borealis version used to build the application. */
#define BOREALIS_LIB_DESCRIBE "@BOREALIS_LIB_DESCRIBE@"

#if defined(__x86_64__) || defined(_M_AMD64)
#define BOREALIS_ARCH "x86_64"
#elif defined(__i386__) || defined(_M_IX86)
#define BOREALIS_ARCH "x86"
#elif defined(__aarch64__) || defined(_M_ARM64)
#define BOREALIS_ARCH "arm64"
#elif defined(__arm__) || defined(_M_ARM)
#define BOREALIS_ARCH "arm"
#else
#define BOREALIS_ARCH "unknown"
#endif

#endif /* BOREALIS_VERSION_H */
